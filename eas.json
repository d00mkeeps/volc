{
  "cli": {
    "version": ">= 12.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.14.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://volc-api.mileshillary.com/dev",
        "EXPO_PUBLIC_WS_URL": "wss://volc-api.mileshillary.com/dev/llm"
      }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "node": "22.14.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://volc-api.mileshillary.com/dev",
        "EXPO_PUBLIC_WS_URL": "wss://volc-api.mileshillary.com/dev/llm"
      }
    },
    "production-test": {
      "distribution": "internal",
      "ios": {
        "buildConfiguration": "Release"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://volc-api.mileshillary.com/dev",
        "EXPO_PUBLIC_WS_URL": "wss://volc-api.mileshillary.com/dev/llm"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://volc-api.mileshillary.com/dev",
        "EXPO_PUBLIC_WS_URL": "wss://volc-api.mileshillary.com/dev/llm"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://volc-api.mileshillary.com",
        "EXPO_PUBLIC_WS_URL": "wss://volc-api.mileshillary.com/llm"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
