{
  "cli": {
    "version": ">= 12.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.mileshillary.com/volc/dev",
        "EXPO_PUBLIC_WS_URL": "wss://api.mileshillary.com/volc/dev/llm"
      }
    },
    "production-test": {
      "distribution": "internal",
      "ios": {
        "buildConfiguration": "Release"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.mileshillary.com/volc/dev",
        "EXPO_PUBLIC_WS_URL": "wss://api.mileshillary.com/volc/dev/llm"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.mileshillary.com/volc/dev",
        "EXPO_PUBLIC_WS_URL": "wss://api.mileshillary.com/volc/dev/llm"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.mileshillary.com/volc",
        "EXPO_PUBLIC_WS_URL": "wss://api.mileshillary.com/volc/llm"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
